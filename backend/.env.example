APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# ── Produkcija ─────────────────────────────────────────────────────────
# Na serveru: FORCE_HTTPS=true (HTTPS linkovi + secure kolačići), APP_URL na
# https://domen. TRUSTED_PROXIES="*" ako aplikacija stoji iza nginx/Apache
# proxy-ja (inače rate limiter i HTTPS detekcija ne rade ispravno).
FORCE_HTTPS=false
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Sesija pada zatvaranjem browsera; secure kolačić prati FORCE_HTTPS.
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=
SESSION_SAME_SITE=lax

# ── Obaveštenja e-poštom ───────────────────────────────────────────────
# Obaveštenja U APLIKACIJI (zvonce, /notifikacije/moja) rade uvek i ne zavise
# ni od čega ispod. Ovaj prekidač uključuje SLANJE ISTOG TEKSTA NA MEJL.
# Ostavi na false dok ne podesiš nalog i ne proveriš ga komandom:
#     php artisan obavestenja:proba tvoja.adresa@example.com
OBAVESTENJA_MEJL=false

# Potpis ispod logotipa u zaglavlju svake poruke.
OBAVESTENJA_NAZIV_BIBLIOTEKE="Biblioteka Akademije tehničko-vaspitačkih strukovnih studija"

# Koliko dana pre isteka roka ide podsetnik. Tekst poruke glasi „ističe sutra",
# pa uz vrednost različitu od 1 treba promeniti i App\Support\PorukeObavestenja.
OBAVESTENJA_DANA_PRE_ISTEKA=1

# Koji nalog se koristi za slanje. Vrednosti: log | gmail | outlook | smtp | failover
#   log      → ništa ne odlazi napolje, poruka se upiše u storage/logs/laravel.log
#   failover → redom proba naloge iz MAIL_FAILOVER_MAILERS dok jedan ne prođe
MAIL_MAILER=log
MAIL_FAILOVER_MAILERS=gmail,outlook,log

# Pošiljalac. Kod Gmail-a i Outlook-a adresa MORA biti ista kao nalog kojim se
# prijavljuješ (ili njegov zvanični alias) — inače je server prepisuje ili odbija.
MAIL_FROM_ADDRESS=biblioteka@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Gmail — lozinka je „App password" (16 znakova, bez razmaka), NE lozinka naloga.
# Nalog mora imati uključenu potvrdu u dva koraka; obična lozinka se odbija.
# Port 587 = STARTTLS (preporuka), 465 = TLS od prvog bajta.
GMAIL_USERNAME=
GMAIL_PASSWORD=
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587

# Outlook / Microsoft 365 — u zakupu (tenant) mora biti dozvoljen SMTP AUTH.
# Microsoft ga postepeno gasi za osnovnu prijavu, pa proveri da li ti je još
# uključen pre nego što se osloniš na njega u produkciji.
OUTLOOK_USERNAME=
OUTLOOK_PASSWORD=
OUTLOOK_HOST=smtp.office365.com
OUTLOOK_PORT=587

# Bilo koji drugi SMTP server (biblioteka, fakultet, Mailtrap za probe...)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=

# ── Bib chatbot — Ollama (generisanje odgovora) ────────────────────────
# Preduslovi (jednom): instalirana Ollama + `ollama pull llama3.2:3b`
OLLAMA_URL=http://127.0.0.1:11434
# Model je case/whitespace-osetljiv — mora tacno ovako.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180
OLLAMA_KEEP_ALIVE=-1
OLLAMA_WARMUP_ENABLED=true
# 700 tokena — sa manje su spiskovi bili preseceni usred recenice;
# 6144 ctx — system prompt nosi RAG kontekst, FAQ primere i spisak zanrova.
OLLAMA_NUM_PREDICT=700
OLLAMA_NUM_CTX=6144
# Broj FIZICKIH CPU jezgara masine na kojoj radi Ollama.
OLLAMA_NUM_THREAD=8

# ── Bib chatbot — Python RAG mikroservis (retrieval) ───────────────────
# Pokretanje: rag_service\start.bat (podesavanja: rag_service\.env.example)
# Preduslov (jednom): `ollama pull nomic-embed-text` + rag_service\setup.bat
# Posle prvog podizanja na novoj bazi obavezno: php artisan ai:reindex
RAG_SERVICE_URL=http://127.0.0.1:8001
# Na serveru postaviti kljuc, ISTI kao RAG_API_KEY u rag_service\.env.
RAG_SERVICE_KEY=
RAG_TIMEOUT=15
RAG_CONNECT_TIMEOUT=3
AI_RAG_TOP_K=5
# Min. cosine da semanticki pogodak udje u kontekst (kalibrisano za
# nomic-embed-text nad ociscenim upitom).
AI_RAG_MIN_SCORE=0.64

# EVAL ruta (Faza D) — eval-only /api/ai/eval/chat bez throttle-a, za brzo
# lokalno merenje golden/held-out seta. Na serveru OSTAVITI false (ruta se
# tada ni ne registruje). Token generisati lokalno (npr. 32 hex znaka).
AI_EVAL_ENABLED=false
AI_EVAL_TOKEN=

# Naučeni primeri (Faza B) — semantičko preuzimanje FAQ parova (dopuna leksičkog
# FaqZnanje). Puni se: php artisan bot:nauci. Default false (A/B merenje).
AI_NAUCENI_PRIMERI=false
AI_NAUCENI_PRAG=0.80
# Najvise ovoliko naucenih parova ide u system prompt.
AI_NAUCENI_MAX=2
# Semantički direktan odgovor: jaka parafraza → kurirani odgovor bez modela
# (rasterećuje hardver na slabom modelu). Prag+margina biraju siguran pogodak.
AI_NAUCENI_DIREKTNO=false
AI_NAUCENI_DIREKTNO_PRAG=0.85
AI_NAUCENI_DIREKTNO_MARGINA=0.03

# Jezicki guard — izlazna provera odgovora Hunspell recnikom preko RAG servisa
# (/proveri-tekst). Recnik sr-Latn sada stize kroz repo u
# rag_service/resources/hunspell/, pa guard radi odmah po deploy-u.
AI_JEZICKI_GUARD=true
