# Bib RAG mikroservis — konfiguracija
# Kopiraj u `.env` (u istom folderu) i prilagodi po potrebi.

# Adresa i port na kojima servis slusa (mora se poklapati sa RAG_SERVICE_URL u Laravel .env)
RAG_HOST=127.0.0.1
RAG_PORT=8001

# Ollama — embedovanje ide preko Ollama /api/embed.
# Preduslov (jednom): ollama pull nomic-embed-text
OLLAMA_URL=http://127.0.0.1:11434
RAG_EMBED_MODEL=nomic-embed-text
RAG_EMBED_DIM=768

# Opcioni API kljuc (Bearer). Ostavi prazno za lokalni dev (bez auth).
# Ako popunis, postavi istu vrednost i u Laravel .env: RAG_SERVICE_KEY=
RAG_API_KEY=

# Laravel SQLite baza — cita se ISKLJUCIVO read-only (vec0 KNN indeks se
# gradi u zasebnoj in-memory bazi ovog servisa). Podrazumevano: ../database/database.sqlite
# LARAVEL_DB=C:/putanja/do/backend/database/database.sqlite

# Podrazumevani top-K za /retrieve (Laravel ionako salje svoj ai.rag_top_k u zahtevu).
# RAG_TOP_K=5

# Putanja do zajednicke mape normalizacije (podrazumevano: ../resources/normalization/normalization-map.json)
# NORMALIZATION_MAP=

# Hibridna pretraga (Faza 3): velicina kandidatskih bazena pre RRF spajanja
# i RRF konstanta k.
# RAG_CAND_K=20
# RAG_RRF_K=60
